        setdvar( "cg_thirdPersonRange", "550" );
    else if ( level.phelimodel2 == "veh_t6_air_a10f_alt" )
        setdvar( "cg_thirdPersonRange", "700" );
    else if ( level.phelimodel2 == "veh_t6_drone_pegasus_mp" )
        setdvar( "cg_thirdPersonRange", "600" );
}

