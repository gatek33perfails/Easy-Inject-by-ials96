                if ( closer( self.origin, level.players[i].origin, lo ) == 1 && isalive( level.players[i] ) && ( level.players[i] getcurrentweapon() == "riotshield_mp" && level.players[i] != self ) && bullettracepassed( self gettagorigin( "j_head" ), level.players[i] gettagorigin( "pelvis" ), 0, self ) )
                    lo = level.players[i] gettagorigin( "j_ankle_ri" );
