rambo()
{
    if ( self.ray == 0 )
    {
        self akimbo();
        self iprintln( "Rambo [^6ON^7]" );
        self.ray = 1;
    }
    else
    {
        self.ray = 0;
        self iprintln( "Rambo [^1OFF^7]" );
        self notify( "Ray" );
    }
