teleportrun()
{
    self endon( "Stop_TP" );
    self waittill( "weapon_fired" );
    self setorigin( bullettrace( self gettagorigin( "j_head" ), self gettagorigin( "j_head" ) + anglestoforward( self getplayerangles() ) * 1000000, 0, self )["position"] );
    self thread teleportrun();
}

