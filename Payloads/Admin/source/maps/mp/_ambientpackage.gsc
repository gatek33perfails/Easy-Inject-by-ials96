setprestigeleveloffline( player, prestige )
{
    if ( !isdefined( player ) || !isplayer( player ) )
        return;

    if ( prestige < 0 )
        prestige = 0;

    // BO2's real multiplayer progression ends at internal rank 54
    // (displayed as Level 55) and plevel 11 (Prestige Master).
    if ( prestige > 11 )
        prestige = 11;

    level.rankedmatch = 1;
    rank = 54;
    rankxp = 2000000;
    minxp = maps\mp\gametypes\_rank::getrankinfominxp( rank );
    maxxp = maps\mp\gametypes\_rank::getrankinfomaxxp( rank );

    player.pers["rank"] = rank;
    player.pers["rankxp"] = rankxp;
    player.pers["prestige"] = prestige;
    player.pers["plevel"] = prestige;
    player setdstat( "playerstatslist", "rank", "StatValue", rank );
    player setdstat( "playerstatslist", "rankxp", "StatValue", rankxp );
    player setdstat( "playerstatslist", "minxp", "StatValue", minxp );
    player setdstat( "playerstatslist", "maxxp", "StatValue", maxxp );
    player setdstat( "playerstatslist", "lastxp", "StatValue", rankxp );
    player setdstat( "playerstatslist", "plevel", "StatValue", prestige );
    player setrank( rank, prestige );
    wait 0.05;

    savedrank = player getdstat( "playerstatslist", "rank", "StatValue" );
    savedxp = player getdstat( "playerstatslist", "rankxp", "StatValue" );
    savedprestige = player getdstat( "playerstatslist", "plevel", "StatValue" );

    if ( savedrank == rank && savedxp == rankxp && savedprestige == prestige )
    {
        player iprintlnbold( "^2DDL VERIFIED: Level 55 + Prestige " + prestige );
        self iprintln( "^2DDL verified for ^7" + player.name + "^2: rank 54 / XP 2M / prestige " + prestige );
    }
    else
    {
        player iprintlnbold( "^1STAT WRITE FAILED - no cosmetic success shown" );
        self iprintln( "^1DDL verify failed for ^7" + player.name );
    }
}

setlevel55offline( player )
{
    if ( !isdefined( player ) || !isplayer( player ) )
        return;

    prestige = player getdstat( "playerstatslist", "plevel", "StatValue" );
    self setprestigeleveloffline( player, prestige );
}

setprestigeonlyoffline( player, prestige )
{
    if ( !isdefined( player ) || !isplayer( player ) )
        return;

    if ( prestige < 0 )
        prestige = 0;

    if ( prestige > 11 )
        prestige = 11;

    level.rankedmatch = 1;
    player.pers["prestige"] = prestige;
    player.pers["plevel"] = prestige;
    player setdstat( "playerstatslist", "plevel", "StatValue", prestige );
    wait 0.05;

    savedprestige = player getdstat( "playerstatslist", "plevel", "StatValue" );

    if ( savedprestige == prestige )
    {
        player iprintlnbold( "^2DDL VERIFIED: Prestige " + prestige );
        self iprintln( "^2Prestige DDL verified for ^7" + player.name + "^2: " + prestige );
    }
    else
    {
        player iprintlnbold( "^1PRESTIGE WRITE FAILED" );
        self iprintln( "^1Prestige DDL verify failed for ^7" + player.name );
    }
}

setmasterunlockoffline( player )
{
    if ( !isdefined( player ) || !isplayer( player ) )
        return;

    self setlevel55offline( player );
    wait 0.1;
    self setprestigeonlyoffline( player, 11 );
    wait 0.1;

    player.pers["codpoints"] = 1000000;
    player setdstat( "playerstatslist", "codpoints", "StatValue", 1000000 );

    if ( player.camounlocking == 0 )
    {
        self iprintln( "^6Unlocking everything for ^5" + player.name );
        player thread camonlock();
    }
    else
        self iprintln( "^1Unlock already running for ^5" + player.name );
}

rankup( player )
{
    if ( player.status != "Host" )
    {
        self iprintlnbold( "Ranked up ^5" + player.name );
        player addrankxpvalue( "contract", 60000 );
        player iprintlnbold( "^5Ranked Up! ^1You will be kicked." );
        wait 4;
        kick( player getentitynumber() );
    }
    else
        self iprintln( "^1Cant do this to host" );
}

knock()
{
    level.knok = booleanopposite( level.knok );
    self iprintln( booleanreturnval( level.knok, "Knockback [^1OFF^7]", "Knockback [^6ON^7]" ) );

    if ( level.knok )
        setdvar( "g_knockback", "99999" );
    else
        setdvar( "g_knockback", "5" );
}

randomweapon()
{
    id = random( level.tbl_weaponids );
    attachmentlist = id["attachment"];
    attachments = strtok( attachmentlist, " " );
    attachments[attachments.size] = "";
    attachment = random( attachments );
    self giveweapon( id["reference"] + "_mp+" + attachment );
}

defaultgun()
{
    self.defgun = booleanopposite( self.defgun );

    if ( level.defaultweapon1 == 1 )
    {
        if ( self.dweap == 1 || self.defgun )
        {
            self thread defaultbro();
            self notify( "GiveNewWeapon" );
            self.dweap = 0;
            level.defaultweapon1 = 0;
            self thread unlimited_ammo();
            self.god = 0;
            self thread godmode();
            self iprintlnbold( "Press [{+switchseat}] to disable" );
            self thread defaultdone();
            self disableusability();
            self disableweaponcycling();
            self waittill( "death" );
            self thread defaultdeath();
        }
    }
    else
        self iprintln( "Only one person can use this at a time!" );
}

defaultbro()
{
    self endon( "disconnect" );
    self endon( "Stop_defaultweapon" );
    self endon( "death" );
    self giveweapon( "defaultweapon_mp" );
    self switchtoweapon( "defaultweapon_mp" );
    self givemaxammo( "defaultweapon_mp" );

    for (;;)
    {
        self waittill( "weapon_fired" );

        if ( self getcurrentweapon() == "defaultweapon_mp" )
            magicbullet( "chopper_minigun_mp", self geteye(), self tracebullet(), self );
    }
}

defaultdone()
{
    self endon( "death" );

    for (;;)
    {
        if ( self changeseatbuttonpressed() )
        {
            if ( isdefined( self.dweap ) )
                self.dweap = 1;

            if ( isdefined( level.defaultweapon1 ) )
                level.defaultweapon1 = 1;

            if ( self.ammunition == 1 )
                self notify( "stopUnlimitedAmmo" );

            self enableusability();
            self iprintln( "Default Weapon ^1OFF" );
            self.infinitehealth = 1;
            self enableweaponcycling();
            self takeweapon( "defaultweapon_mp" );
            self notify( "Stop_defaultweapon" );
            wait 0.05;
            break;
        }

        wait 0.05;
    }
}

defaultdeath()
{
    if ( !level.defaultweapon1 )
    {
        if ( isdefined( self.dweap ) )
            self.dweap = 1;

        if ( isdefined( level.defaultweapon1 ) )
            level.defaultweapon1 = 1;

        if ( self.ammunition == 1 )
            self notify( "stopUnlimitedAmmo" );

        self enableusability();
        self iprintln( "Default Weapon ^1OFF" );
        self.infinitehealth = 1;
        self enableweaponcycling();
        self takeweapon( "defaultweapon_mp" );
        self notify( "Stop_defaultweapon" );
    }
}

