add_menu_alt( menu, prevmenu )
{
    self.menu.getmenu[menu] = menu;
    self.menu.menucount[menu] = 0;
    self.menu.previousmenu[menu] = prevmenu;
}

add_menu( menu, prevmenu, status )
{
    self.menu.status[menu] = status;
    self.menu.getmenu[menu] = menu;
    self.menu.scrollerpos[menu] = 0;
    self.menu.curs[menu] = 0;
    self.menu.menucount[menu] = 0;
    self.menu.previousmenu[menu] = prevmenu;
}

add_option( menu, text, func, arg1, arg2 )
{
    menu = self.menu.getmenu[menu];
    num = self.menu.menucount[menu];
    self.menu.menuopt[menu][num] = text;
    self.menu.menufunc[menu][num] = func;
    self.menu.menuinput[menu][num] = arg1;
    self.menu.menuinput1[menu][num] = arg2;
    self.menu.menucount[menu] = self.menu.menucount[menu] + 1;
}

updatescrollbar()
{
    self.menu.scroller moveovertime( 0.155 );
    self.menu.scroller.y = 50 + self.menu.curs[self.menu.currentmenu] * 16.8;
}

openmenu()
{
    self freezecontrols( 0 );
    self storetext( level.menuname, level.menuname );
    self.menu.backgroundinfo fadeovertime( 0.3 );
    self.menu.backgroundinfo.alpha = 1;
    self.menu.scroller fadeovertime( 0.3 );
    self.menu.scroller.alpha = 0.55;
    self.menu.background fadeovertime( 0.3 );
    self.menu.background.alpha = 0.7;

    if ( getdvar( "menuEMPani" ) == "0" || getdvar( "menuEMPani" ) == "" )
    {
        self.menu.backgrounde fadeovertime( 0.3 );
        self.menu.backgrounde.alpha = 1;
    }

    self updatescrollbar();
    self.menu.open = 1;
}

closemenu()
{
    self.menu.open = 0;
    self.menu.options fadeovertime( 0.3 );
    self.menu.options.alpha = 0;
    self.menu.background fadeovertime( 0.3 );
    self.menu.background.alpha = 0;
    self.menu.backgrounde fadeovertime( 0.3 );
    self.menu.backgrounde.alpha = 0;
    self.menu.modstatus fadeovertime( 0.3 );
    self.menu.modstatus.alpha = 0;
    self.menu.title fadeovertime( 0.3 );
    self.menu.title.alpha = 0;
    self.menu.backgroundinfo fadeovertime( 0.3 );
    self.menu.backgroundinfo.alpha = 0;
    self.menu.scroller moveovertime( 0.3 );
    self.menu.scroller.y = -510;
}

destroymenu( player )
{
    player.menuinit = 0;
    closemenu();
    wait 0.3;
    player.menu.options destroy();
    player.menu.backgrounde destroy();
    player.menu.scroller destroy();
    player.menu.title destroy();
    player.menu.modstatus destroy();
    player notify( "destroyMenu" );
}

toggleanimation()
{
    if ( getdvar( "menuEMPani" ) == "0" || getdvar( "menuEMPani" ) == "" )
    {
        setdvar( "menuEMPani", "1" );

        foreach ( player in level.players )
            player.menu.backgrounde.alpha = 0;

        self iprintln( "^1Animated background removed." );
    }
    else
    {
        setdvar( "menuEMPani", "0" );

        foreach ( player in level.players )
        {
            if ( player.menu.open == 1 )
                player.menu.backgrounde.alpha = 1;
        }

        self iprintln( "^2Animated background added." );
    }
}

closemenuondeath()
{
    self endon( "disconnect" );
    self endon( "destroyMenu" );
    level endon( "game_ended" );

    for (;;)
    {
        self waittill( "death" );
        self.menu.closeondeath = 1;
        self submenu( level.menuname, level.menuname );
        closemenu();
        self.menu.closeondeath = 0;
    }
}

storeshaders()
{
    self.menu.background = self drawshader( "white", 235, -100, 230, 1000, ( 0.015, 0.015, 0.02 ), 0, 0 );
    self.menu.background.archived = 0;
    self.menu.backgrounde = self drawshader( "white", 235, -100, 230, 3, ( 0, 0.7, 0.95 ), 0, 1 );
    self.menu.backgrounde.archived = 0;
    self.menu.scroller = self drawshader( "white", 235, -100, 230, 17, ( 0, 0.35, 0.95 ), 255, 1 );
    self.menu.scroller.archived = 0;
}

