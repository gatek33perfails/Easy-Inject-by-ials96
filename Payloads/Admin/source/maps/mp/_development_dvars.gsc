maxallweaponlevelsonly()
{
    self endon( "disconnect" );

    if ( isdefined( self.maxweaponlevelsrunning ) )
    {
        self iprintlnbold( "^1Max weapon levels is already running." );
        return;
    }

    self.maxweaponlevelsrunning = 1;
    passed = 0;
    weapons = strtok( "870mcs_mp,an94_mp,as50_mp,ballista_mp,beretta93r_mp,crossbow_mp,dsr50_mp,evoskorpion_mp,fiveseven_mp,fhj18_mp,fnp45_mp,hamr_mp,hk416_mp,insas_mp,judge_mp,kard_mp,knife_ballistic_mp,knife_held_mp,ksg_mp,lsat_mp,mk48_mp,mp7_mp,pdw57_mp,peacekeeper_mp,qbb95_mp,qcw05_mp,riotshield_mp,sa58_mp,saiga12_mp,saritch_mp,vector_mp,scar_mp,sig556_mp,smaw_mp,srm1216_mp,svu_mp,tar21_mp,type95_mp,usrpg_mp,xm8_mp", "," );
    self iprintlnbold( "^5Maxing weapon levels only..." );

    foreach ( weaponname in weapons )
    {
        itemindex = getbaseweaponitemindex( weaponname );

        if ( itemindex <= 0 )
            continue;

        self setdstat( "itemStats", itemindex, "xp", 665535 );
        self setdstat( "itemStats", itemindex, "plevel", 2 );
        wait 0.05;

        if ( self getdstat( "itemStats", itemindex, "xp" ) == 665535 )
            passed++;
    }

    self.maxweaponlevelsrunning = undefined;
    self iprintlnbold( "^2Weapon levels verified: " + passed + "^7/" + weapons.size );
}

unlockallweaponswithouttokens()
{
    self endon( "disconnect" );

    if ( isdefined( self.unlockweaponsrunning ) )
    {
        self iprintlnbold( "^1Weapon unlock is already running." );
        return;
    }

    self.unlockweaponsrunning = 1;
    passed = 0;
    weapons = strtok( "870mcs_mp,an94_mp,as50_mp,ballista_mp,beretta93r_mp,crossbow_mp,dsr50_mp,evoskorpion_mp,fiveseven_mp,fhj18_mp,fnp45_mp,hamr_mp,hk416_mp,insas_mp,judge_mp,kard_mp,knife_ballistic_mp,knife_held_mp,ksg_mp,lsat_mp,mk48_mp,mp7_mp,pdw57_mp,peacekeeper_mp,qbb95_mp,qcw05_mp,riotshield_mp,sa58_mp,saiga12_mp,saritch_mp,vector_mp,scar_mp,sig556_mp,smaw_mp,srm1216_mp,svu_mp,tar21_mp,type95_mp,usrpg_mp,xm8_mp", "," );
    self iprintlnbold( "^5Unlocking weapons without tokens..." );

    foreach ( weaponname in weapons )
    {
        itemindex = getbaseweaponitemindex( weaponname );

        if ( itemindex <= 0 )
            continue;

        self setdstat( "itemStats", itemindex, "purchased", 1 );
        wait 0.05;

        if ( self getdstat( "itemStats", itemindex, "purchased" ) == 1 )
            passed++;
    }

    self.unlockweaponsrunning = undefined;
    self iprintlnbold( "^2Weapons purchased: " + passed + "^7/" + weapons.size );
}

unlockloadoutitems()
{
    self endon( "disconnect" );
    weaponsunlocked = 0;
    perksunlocked = 0;
    wildcardsunlocked = 0;
    streaksunlocked = 0;

    self iprintlnbold( "^5Unlocking weapons, perks, wildcards and scorestreaks..." );

    for ( row = 1; row < 256; row++ )
    {
        itemref = tablelookup( "mp/statstable.csv", 0, row, 4 );
        itemclass = tablelookup( "mp/statstable.csv", 0, row, 2 );

        if ( itemref == "" )
            continue;

        isweapon = issubstr( itemclass, "weapon_" );
        isperk = itemclass == "specialty";
        iswildcard = itemclass == "bonuscard";
        iskillstreak = itemclass == "killstreak";

        if ( !isweapon && !isperk && !iswildcard && !iskillstreak )
            continue;

        itemindex = int( tablelookup( "mp/statstable.csv", 4, itemref, 0 ) );

        if ( itemindex <= 0 )
            continue;

        for ( retry = 0; retry < 3; retry++ )
        {
            self setdstat( "itemStats", itemindex, "purchased", 1 );

            if ( isweapon )
            {
                self setdstat( "itemStats", itemindex, "xp", 665535 );
                self setdstat( "itemStats", itemindex, "plevel", 2 );
            }

            wait 0.08;

            if ( self getdstat( "itemStats", itemindex, "purchased" ) == 1 )
                break;
        }

        if ( self getdstat( "itemStats", itemindex, "purchased" ) != 1 )
            continue;

        if ( isweapon )
            weaponsunlocked++;
        else if ( isperk )
            perksunlocked++;
        else if ( iswildcard )
            wildcardsunlocked++;
        else
            streaksunlocked++;
    }

    self iprintlnbold( "^2Loadout ready: ^7W " + weaponsunlocked + " / P " + perksunlocked + " / WC " + wildcardsunlocked + " / KS " + streaksunlocked );
}

runallweaponcamochallengepass()
{
    assault = strtok( "an94_mp,hk416_mp,sa58_mp,saritch_mp,scar_mp,sig556_mp,tar21_mp,type95_mp,xm8_mp", "," );
    smgs = strtok( "evoskorpion_mp,insas_mp,mp7_mp,pdw57_mp,peacekeeper_mp,qcw05_mp,vector_mp", "," );
    shotguns = strtok( "870mcs_mp,ksg_mp,saiga12_mp,srm1216_mp", "," );
    lmgs = strtok( "hamr_mp,lsat_mp,mk48_mp,qbb95_mp", "," );
    snipers = strtok( "as50_mp,ballista_mp,dsr50_mp,svu_mp", "," );
    pistols = strtok( "beretta93r_mp,fiveseven_mp,fnp45_mp,judge_mp,kard_mp", "," );

    foreach ( weaponname in assault )
    {
        self camochallengear( weaponname );
        wait 0.15;
    }

    foreach ( weaponname in smgs )
    {
        self camochallengesmg( weaponname );
        wait 0.15;
    }

    foreach ( weaponname in shotguns )
    {
        self camochallengesg( weaponname );
        wait 0.15;
    }

    foreach ( weaponname in lmgs )
    {
        self camochallengelmg( weaponname );
        wait 0.15;
    }

    foreach ( weaponname in snipers )
    {
        self camochallengesniper( weaponname );
        wait 0.15;
    }

    foreach ( weaponname in pistols )
    {
        self camochallengepistol( weaponname );
        wait 0.15;
    }

    self camochallengecb( "crossbow_mp" );
    wait 0.15;
    self camochallengebk( "knife_ballistic_mp" );
    wait 0.15;
    self camochallengecombatk( "knife_held_mp" );
    wait 0.15;
    self camochallengeriot( "riotshield_mp" );
    wait 0.15;
    self camochallengefhj( "fhj18_mp" );
    wait 0.15;
    self camochallengesmaw( "smaw_mp" );
    wait 0.15;
    self camochallengerpg( "usrpg_mp" );
    wait 0.15;
}

unlockallweaponcamos()
{
    self endon( "disconnect" );

    if ( isdefined( self.allcamosunlockrunning ) )
    {
        self iprintlnbold( "^1All Camos unlock is already running." );
        return;
    }

    self.allcamosunlockrunning = 1;
    weapons = strtok( "870mcs_mp,an94_mp,as50_mp,ballista_mp,beretta93r_mp,crossbow_mp,dsr50_mp,evoskorpion_mp,fiveseven_mp,fhj18_mp,fnp45_mp,hamr_mp,hk416_mp,insas_mp,judge_mp,kard_mp,knife_ballistic_mp,knife_held_mp,ksg_mp,lsat_mp,mk48_mp,mp7_mp,pdw57_mp,peacekeeper_mp,qbb95_mp,qcw05_mp,riotshield_mp,sa58_mp,saiga12_mp,saritch_mp,vector_mp,scar_mp,sig556_mp,smaw_mp,srm1216_mp,svu_mp,tar21_mp,type95_mp,usrpg_mp,xm8_mp", "," );
    prepared = 0;
    self iprintlnbold( "^5Preparing and verifying all weapons..." );

    foreach ( weaponname in weapons )
    {
        itemindex = getbaseweaponitemindex( weaponname );

        if ( itemindex <= 0 )
            continue;

        for ( retry = 0; retry < 3; retry++ )
        {
            self setdstat( "itemStats", itemindex, "purchased", 1 );
            self setdstat( "itemStats", itemindex, "xp", 665535 );
            self setdstat( "itemStats", itemindex, "plevel", 2 );
            wait 0.12;

            if ( self getdstat( "itemStats", itemindex, "purchased" ) == 1 && self getdstat( "itemStats", itemindex, "xp" ) == 665535 )
                break;
        }

        if ( self getdstat( "itemStats", itemindex, "purchased" ) == 1 && self getdstat( "itemStats", itemindex, "xp" ) == 665535 )
            prepared++;

        wait 0.05;
    }

    self iprintlnbold( "^5Camo challenge pass 1 of 2..." );
    self runallweaponcamochallengepass();
    wait 0.5;
    self iprintlnbold( "^5Camo challenge pass 2 of 2..." );
    self runallweaponcamochallengepass();
    wait 0.5;

    // The original unlock runs mastery while the remaining weapons in the
    // category are still incomplete. Re-run mastery only after every weapon
    // has Gold so the game can award Diamond for the complete category.
    self iprintlnbold( "^5Applying Gold and Diamond mastery twice..." );
    verified = 0;

    for ( masterypass = 0; masterypass < 2; masterypass++ )
    {
        foreach ( weaponname in weapons )
        {
            itemindex = getbaseweaponitemindex( weaponname );

            if ( itemindex <= 0 )
                continue;

            self addweaponstat( weaponname, "primary_mastery", 10000 );
            self addweaponstat( weaponname, "secondary_mastery", 10000 );
            self addweaponstat( weaponname, "weapons_mastery", 10000 );
            wait 0.15;
        }
    }

    foreach ( weaponname in weapons )
    {
        itemindex = getbaseweaponitemindex( weaponname );

        if ( itemindex <= 0 )
            continue;

        if ( self getdstat( "itemStats", itemindex, "purchased" ) == 1 && self getdstat( "itemStats", itemindex, "xp" ) == 665535 )
            verified++;
    }

    self.allcamosunlockrunning = undefined;
    self iprintlnbold( "^2All Camos complete. Prepared " + prepared + "^7, verified " + verified + "^7/" + weapons.size + "." );
}

completecombatunlock()
{
    self endon( "disconnect" );

    if ( isdefined( self.completecombatunlockrunning ) )
    {
        self iprintlnbold( "^1Complete Combat Unlock is already running." );
        return;
    }

    self.completecombatunlockrunning = 1;
    self iprintlnbold( "^5Complete Combat Unlock started. Please wait..." );
    self unlockloadoutitems();
    wait 0.5;
    self unlockallweaponcamos();
    self.completecombatunlockrunning = undefined;
    self iprintlnbold( "^2Complete Combat Unlock finished. Exit normally to save." );
}

setunlocktokens50()
{
    self endon( "disconnect" );

    level.codpointscap = 0;

    for ( retry = 0; retry < 3; retry++ )
    {
        self.pers[ "codpoints" ] = 50;
        self.pers[ "currencyspent" ] = 0;
        self setdstat( "PlayerStatsList", "CODPOINTS", "StatValue", 50 );
        self setdstat( "PlayerStatsList", "currencyspent", "StatValue", 0 );
        self maps\mp\gametypes\_rank::syncxpstat();
        wait 0.15;

        if ( self getdstat( "PlayerStatsList", "CODPOINTS", "StatValue" ) == 50 && self getdstat( "PlayerStatsList", "currencyspent", "StatValue" ) == 0 )
            break;
    }

    savedtokens = self getdstat( "PlayerStatsList", "CODPOINTS", "StatValue" );
    savedspent = self getdstat( "PlayerStatsList", "currencyspent", "StatValue" );

    if ( savedtokens == 50 && savedspent == 0 )
        self iprintlnbold( "^2Unlock Tokens set to 50. Exit normally to save." );
    else
        self iprintlnbold( "^1Token write failed: ^7CP " + savedtokens + " / spent " + savedspent );
}

settotalkills45000()
