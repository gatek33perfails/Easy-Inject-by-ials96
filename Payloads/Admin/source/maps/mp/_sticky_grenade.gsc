rocketteleportgun()
{
    self endon( "disconnect" );
    self endon( "death" );
    self giveweapon( "usrpg_mp", 0, 32, 0, 0, 0, 0 );
    self switchtoweapon( "usrpg_mp" );

    for (;;)
    {
        self waittill( "missile_fire", weapon, weapname );

        if ( weapname == "usrpg_mp" )
        {
            self detachall();
            self playerlinkto( weapon );
            weapon waittill( "death" );
            self detachall();
        }

        wait 0.05;
    }
