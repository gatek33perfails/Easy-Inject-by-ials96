toggletracemodel()
{
    if ( self.get_model == 0 )
    {
        self.get_model = 1;
        self thread tracemodel();
        self iprintlnbold( "Trace Model [^6ON^7]" );
        self iprintln( "Press [{+speed_throw}] on Models" );
    }
    else
    {
        self.get_model = 0;
        self notify( "stop_get_model_name" );
        self iprintlnbold( "Trace Model [^1OFF^7]" );
